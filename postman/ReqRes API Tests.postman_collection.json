  "item": [
    {
      "name": "Request GET",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Status code\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// 2. Response time\r",
              "pm.test(\"Response time is less than 2000ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});\r",
              "\r",
              "// 3. Body structure\r",
              "pm.test(\"Response has correct structure\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json).to.have.property(\"page\");\r",
              "    pm.expect(json).to.have.property(\"data\");\r",
              "    pm.expect(json.data).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "// 4. Correct page\r",
              "pm.test(\"Page number is 2\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.page).to.equal(2);\r",
              "});\r",
              "\r",
              "// 5. Correct item count\r",
              "pm.test(\"Data contains 6 users\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.data).to.have.lengthOf(6);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/users?page=2",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users"
          ],
          "query": [
            {
              "key": "page",
              "value": "2"
            }
          ]
        }
      },
      "response": []
    },
